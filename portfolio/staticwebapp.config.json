{
  "routes": [
    {
      "route": "/*",
      "rewrite": "/index.html"
    },
    {
      "route": "/assets/*",
      "rewrite": "/assets/*"
    },
    {
      "route": "/*.json",
      "rewrite": "/*.json"
    },
    {
      "route": "/*.css",
      "rewrite": "/*.css"
    },
    {
      "route": "/*.js",
      "rewrite": "/*.js"
    }
  ]
}

